{
  "hosting": {
    "site": "todd-sayit",
    "public": "dist/sayit/browser",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.DS_Store",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.csr.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9399
    },
    "firestore": {
      "port": 8380
    },
    "ui": {
      "enabled": true,
      "port": 4601
    }
  }
}
