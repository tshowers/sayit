rules_version = '2';

// Emulator-only rules for Cypress coverage (cypress/e2e/*.cy.ts run against
// `firebase emulators:exec`, never against the real taliferrotech project).
// deploy.sh only ever deploys hosting:todd-sayit, so these never reach
// production. SayIt reads and writes everything under the Taliferro master
// tenant plus the top-level posts collection, so the emulator just needs to
// let anyone read and a signed-in user write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
